# ============================================================
# .env.example — Template cấu hình cho Novel Translator
# Copy file này thành .env và điền giá trị thật của bạn.
#   cp .env.example .env
# ⚠️  KHÔNG bao giờ commit file .env vào git!
# ============================================================


# ── Gemini (PRIMARY — FREE) ────────────────────────────────
# Tạo key miễn phí tại: https://aistudio.google.com/app/apikey
# Mỗi Gmail = 1 key, hỗ trợ nhiều key cách nhau bằng dấu phẩy
# 5 key × 1500 req/ngày = 7500 req/ngày ≈ 22500 chương miễn phí
GOOGLE_API_KEYS="your_gemini_key_1, your_gemini_key_2"
GEMINI_MODEL=gemini-2.0-flash

# Các model fallback khi model chính lỗi (liệt kê theo thứ tự ưu tiên)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-flash-lite-latest


# ── DeepSeek (FALLBACK — ~$0.002/chương) ──────────────────
# Tạo key tại: https://platform.deepseek.com
# Model: deepseek-chat (V3) | deepseek-reasoner
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat


# ── Groq (FALLBACK — Free tier) ───────────────────────────
# Tạo key tại: https://console.groq.com
# Model khuyên dùng: llama-3.3-70b-versatile (14400 req/ngày free)
# Lưu ý: Groq có context limit nhỏ hơn (8192 tokens) → giảm BATCH_SIZE xuống 1-2
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile


# ── Ollama (OPTIONAL — Local GPU) ─────────────────────────
# Chạy model dịch cục bộ, không cần internet
# Setup: https://ollama.com/download → ollama pull hunyuan-mt
# Yêu cầu: RTX 4060 8GB trở lên cho Hunyuan-MT-7B Q4_K_M
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hunyuan-mt
OLLAMA_TIMEOUT=120


# ── Provider ưu tiên ──────────────────────────────────────
# auto    = Gemini → DeepSeek → Ollama (local) theo thứ tự
# gemini  = Chỉ dùng Gemini
# deepseek = Chỉ dùng DeepSeek
# ollama  = Chỉ dùng Ollama (cần OLLAMA_ENABLED=true)
# groq    = Chỉ dùng Groq
TRANSLATION_PROVIDER=auto


# ── Batch translation ──────────────────────────────────────
# BATCH_SIZE: số chương gộp trong 1 lần gọi AI (1–10)
#   Gemini free tier output cap ~8192 tokens → khuyên dùng 2-3
#   Groq có limit nhỏ hơn → dùng 1-2
BATCH_SIZE=3

# BATCH_MAX_CHARS: tổng ký tự tối đa của 1 batch
#   Gemini/DeepSeek: ~20000 | Groq: ~8000
BATCH_MAX_CHARS=8000


# ── Rate limiting ──────────────────────────────────────────
# Gemini free tier: 15 requests/phút → delay tối thiểu 4s
# Set = 0 nếu dùng paid tier
REQUEST_DELAY_SECONDS=4


# ── Scraper ────────────────────────────────────────────────
# HEADLESS=true  → ẩn cửa sổ trình duyệt (production)
# HEADLESS=false → hiển thị để debug khi site block bot
HEADLESS=true

# ── Auth (Web UI admin) ──
# Mật khẩu đăng nhập admin trên Web UI — kiểm tra ở server-side
ADMIN_PASSWORD=change-me-please
# Thời hạn token (giây), mặc định 7 ngày
AUTH_TOKEN_TTL=604800
# CORS origins bổ sung (ngoài localhost), cách nhau dấu phẩy
# ALLOWED_ORIGINS=https://your-domain.com
