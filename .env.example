# Sao chép thành .env. Không commit key/mật khẩu thật.
# Model và quota do provider quyết định; cấu hình này không cam kết miễn phí.
GOOGLE_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=model-1,model-2
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TRANSLATION_PROVIDER=auto
FALLBACK_ORDER=gemini,deepseek

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hunyuan-mt
OLLAMA_TIMEOUT=600

BATCH_SIZE=2
BATCH_MAX_CHARS=8000
REQUEST_DELAY_SECONDS=4
SCRAPE_DELAY_SECONDS=2
HEADLESS=false

# Đặt mật khẩu trước khi đăng nhập admin; bỏ trống sẽ từ chối đăng nhập.
ADMIN_PASSWORD=
AUTH_TOKEN_TTL=604800
# ALLOWED_ORIGINS=https://your-domain.example
ADK_ENABLED=false

# Cloud mặc định tắt ghi; ngân sách chỉ là ước tính cục bộ, không phải billing.
HACDAO_ALLOW_CLOUD_WRITES=false
HACDAO_SYNC_KEY=
HACDAO_SYNC_HOST=hac-dao-truyen.nguyenbaosang1998.workers.dev
HACDAO_R2_WRITE_BUDGET=0
HACDAO_D1_WRITE_BUDGET=0
HACDAO_MAX_OPS_PER_RUN=0
# HACDAO_BUDGET_FILE=/path/to/shared/.cloud_sync_budget.json
