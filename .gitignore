# ============================================================
# NOVEL TRANSLATOR — .gitignore
# Python backend + React/Node frontend + Chrome Extension
# ============================================================

# ─────────────────────────────────────────────
# ⚠️  SENSITIVE / SECRET FILES — NEVER COMMIT
# ─────────────────────────────────────────────
.env
.env.*
!.env.example

# Firebase / Google Services
google-services.json
GoogleService-Info.plist

# Keystores & Certificates
*.jks
*.keystore
*.p12
*.pem
*.cer
*.pfx
*.key
key_status.json

# ─────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.env.bak

# Pytest
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# mypy / pyright
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Ruff / Black / isort
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# ─────────────────────────────────────────────
# NODE / FRONTEND
# ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Build output
dist/
build/

# ─────────────────────────────────────────────
# CLOUDFLARE SYNC STATE — local only
# ─────────────────────────────────────────────
.sync_state.json

# ─────────────────────────────────────────────
# PROJECT DATA — TRÁNH COMMIT DỮ LIỆU TRUYỆN
# ─────────────────────────────────────────────
# Bỏ comment dòng dưới nếu bạn muốn exclude toàn bộ data truyện
# novels/
# logs/
# discover_results/

# Bỏ comment nếu chỉ muốn exclude nội dung nhưng giữ folder structure
# novels/**/*.txt
# novels/**/*.md
# logs/**/*.log
# logs/**/*.json

# ─────────────────────────────────────────────
# OS / EDITOR
# ─────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# Emacs
*~
\#*\#
.\#*

# ─────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.patch
.cache/
tmp/
temp/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
