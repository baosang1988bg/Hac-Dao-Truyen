# Header cho file tĩnh do Cloudflare Static Assets phục vụ THẲNG (không qua
# Worker — xem "run_worker_first" trong wrangler.jsonc). Phải khớp với
# withStaticCacheHeaders() trong src/index.js (dùng khi request vẫn đi qua Worker).

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/icon-192.svg
  Cache-Control: public, max-age=86400

/icon-512.svg
  Cache-Control: public, max-age=86400

/vite.svg
  Cache-Control: public, max-age=86400
