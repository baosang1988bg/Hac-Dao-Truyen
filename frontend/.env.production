# Biến build cho production (Vite tự nạp khi `vite build`).
# Measurement ID GA4 không phải bí mật (hiện công khai trong HTML) nên được commit
# để mọi máy deploy (Mac, Windows/Antigravity, CI) build ra cùng một cấu hình.
# KHÔNG đặt secret vào file này.
VITE_GA4_MEASUREMENT_ID=G-V8FYCECLZ8
# Client ID OAuth Google (Web application) — KHÔNG phải bí mật (Google hiển thị nó
# công khai trong trang). Phải trùng GOOGLE_CLIENT_ID trong wrangler.jsonc.
VITE_GOOGLE_CLIENT_ID=889163934380-a5o8hv37cjhb916lu7ntg5qelm958bgm.apps.googleusercontent.com
