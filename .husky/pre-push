#!/bin/sh
# pre-push: chạy Python tests trước khi push lên remote
echo "🧪 Chạy Python unit tests..."
python -m pytest test_novel_manager.py -v --tb=short 2>/dev/null || python test_novel_manager.py

# Kiểm tra xem frontend có test không
if [ -f "frontend/package.json" ] && grep -q '"test"' frontend/package.json; then
  echo "🧪 Chạy Frontend tests..."
  cd frontend && npm test -- --watchAll=false
fi

echo "✅ Tất cả tests passed!"
