{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hac-dao-truyen",
	"main": "src/index.js",
	"compatibility_date": "2026-05-07",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "frontend/dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ALLOW_SYNC_WRITES": "true",
		// Client ID OAuth 2.0 (Web application) tạo ở Google Cloud Console >
		// APIs & Services > Credentials. KHÔNG phải secret (cùng giá trị này
		// cũng lộ ra ở frontend qua VITE_GOOGLE_CLIENT_ID) — dùng để verify
		// "aud" của id_token, xem userGoogleLogin() trong src/index.js.
		"GOOGLE_CLIENT_ID": ""
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hacdao-db",
			"database_id": "284ebf75-a325-49b7-a065-818188a76b7b"
		}
	],
	"r2_buckets": [
		{
			"binding": "CHAPTERS",
			"bucket_name": "hacdao-chapters"
		}
	],
	// R06: rate limit chia sẻ THẬT giữa mọi isolate (khác _rateLimitMap trong
	// src/index.js — chỉ là fallback per-isolate khi thiếu binding này). Giới
	// hạn khớp đúng `maximum` từng category trong handleApi() (src/index.js).
	// namespace_id tự chọn, chỉ cần duy nhất trong Worker này — không cần tạo
	// gì trước ở Cloudflare Dashboard.
	"ratelimits": [
		{ "name": "SYNC_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
		{ "name": "AUTH_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
		{ "name": "PUBLIC_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
	]
}